# APISIX Configuration
APISIX_IMAGE=apache/apisix:latest
APISIX_DASHBOARD_IMAGE=apache/apisix-dashboard:latest

# ETCD Configuration
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.16
ETCD_CLUSTER_TOKEN=etcd-cluster

# HAProxy Configuration
HAPROXY_IMAGE=haproxy:latest

# Admin Keys (CHANGE THESE IN PRODUCTION!)
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1
APISIX_VIEWER_KEY=4054f7cf07e344346cd3f287985e76a2

# Dashboard Authentication (CHANGE THESE IN PRODUCTION!)
DASHBOARD_SECRET=secret
DASHBOARD_ADMIN_USER=admin
DASHBOARD_ADMIN_PASSWORD=admin

# Network Configuration
APISIX_HTTP_PORT=8070
APISIX_HTTPS_PORT=7443
APISIX_DASHBOARD_PORT=9000
HAPROXY_STATS_PORT=8404

# Node Ports (for direct access to individual nodes)
APISIX1_HTTP_PORT=9180
APISIX1_HTTPS_PORT=9543
APISIX2_HTTP_PORT=9181
APISIX2_HTTPS_PORT=9544
APISIX3_HTTP_PORT=9182
APISIX3_HTTPS_PORT=9545

# Log Level
APISIX_LOG_LEVEL=warn
DASHBOARD_LOG_LEVEL=warn
